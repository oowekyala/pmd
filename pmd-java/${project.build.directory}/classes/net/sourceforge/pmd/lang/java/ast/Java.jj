String VoidName()      :
/*
 * A lookahead of 2 is required below since "Name" can be followed
 * by a ".*" when used in the context of an "ImportDeclaration",
 * or with "this" or "super" in PrimaryPrefix (AmbiguousName).
 */
{
  StringBuilder s = new StringBuilder();
  JavaccToken t;
}
{
  t=<IDENTIFIER>                    { t.getImageCs().appendChars(s); }
  ( LOOKAHEAD(2) "." t=<IDENTIFIER> { t.getImageCs().appendChars(s.append('.')); }
  )*
  {return s.toString();}
}


void VoidNameNoString()      :
{
}
{
  <IDENTIFIER> ( LOOKAHEAD(2) "." <IDENTIFIER> )*
}


String VoidNameNoLookahead()      :
{
  StringBuilder s = new StringBuilder();
  JavaccToken t;
}
{
  t=<IDENTIFIER>       { t.getImageCs().appendChars(s); }
  ( "." t=<IDENTIFIER> { t.getImageCs().appendChars(s.append('.')); } )*
  {return s.toString();}
}

